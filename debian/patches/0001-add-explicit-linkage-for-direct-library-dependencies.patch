diff --git a/gst-plugin-mlaclassification/CMakeLists.txt b/gst-plugin-mlaclassification/CMakeLists.txt
index 07c213a0..702491c3 100644
--- a/gst-plugin-mlaclassification/CMakeLists.txt
+++ b/gst-plugin-mlaclassification/CMakeLists.txt
@@ -49,6 +49,13 @@ else()
   pkg_check_modules(GST_QCOM_MEM
     REQUIRED gstreamer-qcom-oss-memory-1.0>=1.0.0)
 endif()
+if(TARGET gstqtiallocatorsbase)
+  set(GST_QCOM_ALLOC_INCLUDE_DIRS "")
+  set(GST_QCOM_ALLOC_LIBRARIES    gstqtiallocatorsbase)
+else()
+  pkg_check_modules(GST_QCOM_ALLOC
+    REQUIRED gstreamer-qcom-oss-allocators-1.0>=1.0.0)
+endif()
 
 # Generate configuration header file with plugin describing definitions
 configure_file(config.h.in config.h @ONLY)
@@ -82,6 +89,7 @@ target_include_directories(${GST_QTI_ML_AUDIO_CLASSIFICATION} PUBLIC
   ${GST_QCOM_VIDEO_INCLUDE_DIRS}
   ${GST_QCOM_ML_INCLUDE_DIRS}
   ${GST_QCOM_MEM_INCLUDE_DIRS}
+  ${GST_QCOM_ALLOC_INCLUDE_DIRS}
 )
 
 target_link_libraries(${GST_QTI_ML_AUDIO_CLASSIFICATION} PRIVATE
@@ -95,6 +103,7 @@ target_link_libraries(${GST_QTI_ML_AUDIO_CLASSIFICATION} PRIVATE
   ${GST_QCOM_VIDEO_LIBRARIES}
   ${GST_QCOM_MEM_LIBRARIES}
   ${GST_QCOM_UTILS_LIBRARIES}
+  ${GST_QCOM_ALLOC_LIBRARIES}
 )
 
 install(
