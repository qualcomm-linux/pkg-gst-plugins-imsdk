 gstreamer1.0-plugins-imsdk-metamux,
 gstreamer1.0-plugins-imsdk-metatransform,
 gstreamer1.0-plugins-imsdk-mlaclassification,
 gstreamer1.0-plugins-imsdk-mlaconverter,
 gstreamer1.0-plugins-imsdk-mldemux,
 gstreamer1.0-plugins-imsdk-mlmetaextractor,
 gstreamer1.0-plugins-imsdk-mlmetaparser,
 gstreamer1.0-plugins-imsdk-mlpostprocess,
 gstreamer1.0-plugins-imsdk-mlvclassification,
 gstreamer1.0-plugins-imsdk-mlvconverter,
 gstreamer1.0-plugins-imsdk-mlvdetection,
 gstreamer1.0-plugins-imsdk-mlvpose,
 gstreamer1.0-plugins-imsdk-mlvsegmentation,
 gstreamer1.0-plugins-imsdk-mlvsuperresolution,
 gstreamer1.0-plugins-imsdk-msgbroker,
 gstreamer1.0-plugins-imsdk-objtracker,
 gstreamer1.0-plugins-imsdk-redissink,
 gstreamer1.0-plugins-imsdk-restricted-zone,
 gstreamer1.0-plugins-imsdk-rtspbin,
 gstreamer1.0-plugins-imsdk-socket,
 gstreamer1.0-plugins-imsdk-tools,
 gstreamer1.0-plugins-imsdk-uridecodebin,
